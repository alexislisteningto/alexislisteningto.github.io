{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alex-is-listening-to",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LASTFM_USER": "nobody__home",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAECMW5S493O188Fu",
    "TURNSTILE_HOSTNAMES": "alex-is-listening-to.alex-f16.workers.dev,alexislisteningto.github.io",
    "ALLOWED_ORIGINS": "https://alex-is-listening-to.alex-f16.workers.dev,https://alexislisteningto.github.io"
  },
  "ratelimits": [
    {
      "name": "RECOMMEND_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
